	<dataset name="DatasetGraph" uuid="83606aee-606c-46c1-aa6e-a9869c9481e7">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Eventik Adapter"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<query language="sql"><![CDATA[SELECT s.name AS service_name, COUNT(o.id) AS total_orders FROM orders o JOIN services s ON o.serviceId = s.id GROUP BY s.name]]></query>
		<field name="service_name" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="name"/>
			<property name="com.jaspersoft.studio.field.label" value="service_name"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="services"/>
		</field>
		<field name="total_orders" class="java.lang.Long">
			<property name="com.jaspersoft.studio.field.name" value="total_orders"/>
			<property name="com.jaspersoft.studio.field.label" value="total_orders"/>
		</field>
	</dataset>
	<parameter name="img_header" class="java.io.InputStream"/>
	<parameter name="title" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT 
    o.id,
    u.username AS customer_name,
    s.name AS service_name,
    o.appointment,
    o.status,
    o.priceFinal
FROM orders o
JOIN users u ON o.customerId = u.id
JOIN services s ON o.serviceId = s.id]]></query>
	<field name="id" class="java.lang.String"/>
	<field name="service_name" class="java.lang.String"/>
	<field name="customer_name" class="java.lang.String"/>
	<field name="appointment" class="java.sql.Date"/>
	<field name="status" class="java.lang.String"/>
	<field name="priceFinal" class="java.lang.Double"/>
