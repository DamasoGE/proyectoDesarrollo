<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane fx:id="sidebarPane" maxHeight="720.0" maxWidth="275.0" minHeight="720.0" minWidth="200.0" prefHeight="720.0" prefWidth="200.0" style="-fx-background-color: #2F72A9;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="proyectoDesarrollo.controllers.SidebarLoggedController">
   <bottom>
      <Button fx:id="buttonExit" mnemonicParsing="false" onAction="#buttonExitOnAction" prefHeight="97.0" prefWidth="66.0" style="-fx-background-color: transparent;" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </BorderPane.margin>
         <graphic>
            <ImageView fitHeight="50.0" fitWidth="141.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@images/logout_icon.png" />
               </image>
            </ImageView>
         </graphic>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
   </bottom>
   <top>
      <VBox alignment="CENTER" prefHeight="274.0" prefWidth="275.0" BorderPane.alignment="CENTER">
         <children>
            <ImageView fx:id="imageViewUser" fitHeight="104.0" fitWidth="102.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@images/default_user.png" />
               </image>
            </ImageView>
            <Text fx:id="labelUser" fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="user">
               <font>
                  <Font size="34.0" />
               </font>
            </Text>
            <Text fx:id="labelRole" fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="user.role">
               <font>
                  <Font size="20.0" />
               </font>
            </Text>
            <Button fx:id="profileButton" mnemonicParsing="false" onAction="#profileButtonOnAction" style="-fx-background-color: transparent;">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
               <padding>
                  <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
               </padding>
               <font>
                  <Font size="20.0" />
               </font>
               <graphic>
                  <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@images/profile_logo.png" />
                     </image>
                  </ImageView>
               </graphic>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
         </children>
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </padding>
      </VBox>
   </top>
   <center>
      <VBox alignment="CENTER" prefHeight="290.0" prefWidth="200.0">
         <children>
            <Button fx:id="usersButton" mnemonicParsing="false" onAction="#usersButtonOnAction" prefHeight="65.0" prefWidth="175.0" style="-fx-background-color: transparent;" styleClass="sectionButton" text=" Users" textFill="WHITE">
               <font>
                  <Font size="25.0" />
               </font>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
               <graphic>
                  <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@images/users_logo.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
            <Button fx:id="servicesButton" mnemonicParsing="false" onAction="#servicesButtonOnAction" prefHeight="65.0" prefWidth="175.0" style="-fx-background-color: transparent;" styleClass="sectionButton" text=" Services" textFill="WHITE">
               <font>
                  <Font size="25.0" />
               </font>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
               <graphic>
                  <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@images/services_logo.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
            <Button fx:id="ordersButton" mnemonicParsing="false" onAction="#ordersButtonOnAction" prefHeight="60.0" prefWidth="175.0" style="-fx-background-color: transparent;" styleClass="sectionButton" text=" Orders" textFill="WHITE">
               <font>
                  <Font size="25.0" />
               </font>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
               <graphic>
                  <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@images/order_logo.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
         </children>
      </VBox>
   </center>
</BorderPane>
