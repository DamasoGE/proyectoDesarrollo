<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<StackPane prefHeight="720.0" prefWidth="456.0" style="-fx-border-color: transparent transparent transparent lightgray; -fx-border-width: 0 0 0 2;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="proyectoDesarrollo.controllers.ReportPanelControllerView">
   <children>
      <VBox prefHeight="200.0" prefWidth="100.0">
         <children>
            <ToolBar prefHeight="40.0" prefWidth="600.0">
              <items>
                  <Button fx:id="createReport" mnemonicParsing="false" onAction="#createReportOnAction" prefHeight="33.0" prefWidth="100.0" text="Create Report" />
                  <Button fx:id="savePDF" mnemonicParsing="false" onAction="#savePDFOnAction" prefHeight="33.0" prefWidth="100.0" text="Save pdf" />
                  <CheckBox fx:id="checkboxEmbedded" mnemonicParsing="false" selected="true" text="Embedded" />
              </items>
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
            </ToolBar>
            <WebView fx:id="webView" prefHeight="680.0" prefWidth="454.0" />
         </children>
      </VBox>
   </children>
</StackPane>
